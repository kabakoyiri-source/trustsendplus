{
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/concept-icon(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/apple-touch-icon.png", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "rewrites": [
    {
      "source": "/((?!assets(?:/|$)|images(?:/|$)|fonts(?:/|$)|tokens(?:/|$)|api(?:/|$)|concept-icon[^/]*$|receive-qr\\.svg$|apple-touch-icon\\.png$|service-worker\\.js$|manifest\\.json$|index\\.html$).*)",
      "destination": "/index.html"
    }
  ]
}
